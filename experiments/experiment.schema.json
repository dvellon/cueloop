{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cueloop.local/schemas/experiment-v1.json",
  "title": "CueLoop predeclared experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "title",
    "status",
    "question",
    "evidence_tier",
    "method",
    "independent_variables",
    "dependent_variables",
    "controls",
    "sample_plan",
    "acceptance_target",
    "safety_privacy",
    "result_record"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "pattern": "^EXP-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "status": {"enum": ["planned", "running", "complete", "cancelled"]},
    "question": {"type": "string", "minLength": 1, "maxLength": 1000},
    "evidence_tier": {
      "enum": ["simulated", "development-computer", "UNO Q", "physical CuePod", "estimated"]
    },
    "method": {"type": "string", "minLength": 1, "maxLength": 4000},
    "independent_variables": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "dependent_variables": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "controls": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "sample_plan": {"type": "string", "minLength": 1, "maxLength": 2000},
    "acceptance_target": {"type": "string", "minLength": 1, "maxLength": 1000},
    "safety_privacy": {"type": "string", "minLength": 1, "maxLength": 2000},
    "result_record": {"type": "string", "minLength": 1, "maxLength": 500}
  }
}
